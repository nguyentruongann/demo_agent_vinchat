# Copy this file to .env and fill in local values. Never commit real secrets.
POSTGRES_DB=vinpearl
POSTGRES_USER=vinpearl
POSTGRES_PASSWORD=<YOUR_EXISTING_LOCAL_POSTGRES_PASSWORD>
DATABASE_URL=postgresql+pg8000://vinpearl:<PASSWORD>@localhost:5432/vinpearl
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_API_KEY_BACKUP=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Gemini is the only embedding backend. Do not reuse an E5/ONNX collection.
EMBEDDING_BACKEND=gemini_api
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=3072
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=20
CHROMA_DIR=./storage/chroma_local
CHROMA_COLLECTION=vinpearl_gemini_embedding_001_v2
KNOWLEDGE_SCHEMA_VERSION=2

TOP_K=5
MAX_CONTEXT_CHARS=12000
EXHAUSTIVE_MAX_CONTEXT_CHARS=24000
MIN_RELEVANCE_SCORE=0.5
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=16
MEMORY_MAX_CHARS=12000

RUN_MIGRATIONS=true
BOOTSTRAP_CORE_DATA=false
REBUILD_CHROMA_ON_START=false
ADMIN_BOOTSTRAP_KEY=<GENERATE_A_LOCAL_RANDOM_SECRET>
AGENT_API_KEY=<GENERATE_A_DIFFERENT_LOCAL_RANDOM_SECRET>
CORS_ORIGINS=http://localhost:5173
EXPOSE_CHAT_DEBUG=false
