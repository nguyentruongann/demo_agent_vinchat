# ============================================================
# Railway reference — do NOT use this as one combined service env file.
# Copy the BACKEND block to the Backend service and FRONTEND block
# to the Frontend service. Service names below assume:
# Backend / Frontend / Postgres / Redis
# ============================================================

# =========================
# BACKEND SERVICE
# =========================
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_API_KEY_BACKUP=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

EMBEDDING_BACKEND=gemini_api
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=3072
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_SECONDS=1
EMBEDDING_RETRY_MAX_SECONDS=20

CHROMA_DIR=/app/storage/chroma_local
CHROMA_COLLECTION=vinpearl_gemini_embedding_001_v2
KNOWLEDGE_SCHEMA_VERSION=2
TOP_K=5
MAX_CONTEXT_CHARS=12000
MIN_RELEVANCE_SCORE=0.35

MEMORY_ENABLED=true
MEMORY_MAX_TURNS=16
MEMORY_MAX_CHARS=12000

RUN_MIGRATIONS=true
BOOTSTRAP_CORE_DATA=false
REBUILD_CHROMA_ON_START=false

ADMIN_BOOTSTRAP_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
AUTH_SESSION_DAYS=7
PASSWORD_PBKDF2_ITERATIONS=600000
AGENT_API_KEY=<GENERATE_A_LONG_RANDOM_SECRET>

APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}

# Railway volumes are mounted as root while the backend image declares appuser.
# This Railway-provided setting prevents write-permission errors on /app/storage.
RAILWAY_RUN_UID=0

# Optional AI logging
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<YOUR_AI_LOG_API_KEY>
AI_LOG_DIR=.ai-log

# =========================
# FRONTEND SERVICE
# =========================
VITE_API_BASE_URL=https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
VITE_ENABLE_CHAT_FALLBACK=false
